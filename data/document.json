0}}],"schema":"harvard-drs-428712045-transcription/1","units":[{"bbox":null,"gaps":[],"id":"p001-u001","layer":"paratext","order":1,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"paratext","text":"耶穌教簡要格言","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u002","layer":"paratext","order":2,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"paratext","text":"辨世人祀鬼論","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u003","layer":"body","order":3,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"以約哉耶穌之教也、其教人只崇一造物上帝、從未嘗","uncertainties":[{"candidates":["以","大"],"length":1,"offset":0,"reason":"欄首字形在縮圖上不夠清楚"},{"candidates":["未","来"],"length":1,"offset":21,"reason":"字形近「耒／未」，筆畫不夠清楚"}]},{"bbox":null,"gaps":[],"id":"p001-u004","layer":"body","order":4,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"諂祀乎鬼夫鬼本無尊、而人竟視為至尊而敬之鬼本","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u005","layer":"body","order":5,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"無靈、而人竟視為有靈而奉之此無他寔世之人好為","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u006","layer":"body","order":6,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"怪誕、而鬼心未泯故耳噫嘻、人心之罔昧由来久矣、夫","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u007","layer":"body","order":7,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"人自初生、本有悪心、一自邪魔誘惑私慾交加、則悪心","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u008","layer":"body","order":8,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"起矣、悪心起而鬼心熾、鬼心熾則壯氣消、壯氣消則怯","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u009","layer":"body","order":9,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"心生、怯心生則無往而非鬼即無人而不怕鬼矣嗚呼、","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u010","layer":"body","order":10,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"此祀鬼之端、所由昉也吾謂人愈祀鬼、鬼愈入其心、于","uncertainties":[{"candidates":["吾"],"length":1,"offset":10,"reason":"旁邊有墨斑或破孔，字形有部分被遮"}]},{"bbox":null,"gaps":[],"id":"p001-u011","layer":"body","order":11,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"此欲離之而無可離、欲避之而不能避、勢必至于設香","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u012","layer":"body","order":12,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"横献牲醴急欲有以諂祀乎鬼夫鬼亦何可諂哉我即","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u013","layer":"body","order":13,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"諂鬼鬼固不能賜福與我、我即不諂鬼、鬼亦不能降禍","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u014","layer":"body","order":14,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"與我我寧自安于不祀不瀆、不惟人品高超、即天心亦","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u015","layer":"body","order":15,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"多泰然自適之趣、況鬼本無物、並無身体髮膚以受飢","uncertainties":[{"candidates":["趣"],"length":1,"offset":6,"reason":"此字位置有黑色破孔或墨斑，只見殘筆"}]},{"bbox":null,"gaps":[],"id":"p001-u016","layer":"body","order":16,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"渴之害、縱有嘉餚備具只見人食之、未見鬼嘗之使鬼","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u017","layer":"body","order":17,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"果貿貿然而来享人之祀也、人將譁然喊曰鬼至矣、可","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u018","layer":"body","order":18,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"先奔念此群相奔命、尚恐不遑奚敢或在門首、或在墓","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u019","layer":"body","order":19,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"前焚香叩拜招其来而麾其去乎雖曰鬼乃人之死氣、","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u020","layer":"body","order":20,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"然亦不過一線之魂、既赴陰間、生死異路斷不能復来","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u021","layer":"body","order":21,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"陽世與人類相周旋、使死者猶能與陽人相周旋試問","uncertainties":[{"candidates":["者"],"length":1,"offset":11,"reason":"此字位置有黑色破孔，字形大半被遮"}]},{"bbox":null,"gaps":[],"id":"p001-u022","layer":"body","order":22,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"生者何無一人到陰間與鬼類為友乎、祢劝世人棄此","uncertainties":[{"candidates":["祢","弥"],"length":1,"offset":16,"reason":"偏旁在縮圖上不能確定"}]},{"bbox":null,"gaps":[],"id":"p001-u023","layer":"body","order":23,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"無益之舉、而信順耶穌恪守上帝之誡命曰我之外、尔","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u024","layer":"body","order":24,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"不可有别神、我者上帝自謂也、尔者指世之人也上帝","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u025","layer":"body","order":25,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"預知人心好鬼貽害匪輕故十誡之中首為厲禁從可","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u026","layer":"body","order":26,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"知一切鬼魅、皆可將上帝所賦之壯氣而攻逆之不庸","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u027","layer":"body","order":27,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"祀、昔之諂祀出于不知、其非尚輕、今既知之、尚如是而","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u028","layer":"body","order":28,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"仍蹈前轍、則其罪靡涯矣、吾願世之人速自悔改、倚賴","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u029","layer":"body","order":29,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"body","text":"耶穌以赦其罪之為幸也、","uncertainties":[]},{"bbox":null,"gaps":[],"id":"p001-u030","layer":"imprint","order":30,"page_id":"p001","review_status":"ai-initial-unreviewed","role":"imprint","text":"在廈刊送","uncertainties":[]}]}
